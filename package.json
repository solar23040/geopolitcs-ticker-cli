{
  "name": "geoticker",
  "version": "1.0.0",
  "description": "Geopolitics news ticker terminal app",
  "type": "module",
  "bin": {
    "geoticker": "dist/index.js"
  },
  "scripts": {
    "dev:cli": "tsx src/cli/index.tsx",
    "dev:server": "tsx src/server/index.ts",
    "dev:web": "npm --prefix web start -- --proxy-config proxy.conf.json",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build:cli": "tsup",
    "build:web": "npm --prefix web run build",
    "build": "tsup && npm --prefix web run build",
    "test": "tsx --test src/lib/",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@libsql/client": "^0.18.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "concurrently": "^10.0.6",
    "hono": "^4.13.13",
    "ink": "^5.2.1",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "rss-parser": "^3.13.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
