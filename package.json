{
  "name": "geoticker",
  "version": "1.0.0",
  "description": "Geopolitics news ticker terminal app",
  "type": "module",
  "bin": {
    "geoticker": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup src/index.tsx --format esm --out-dir dist --clean",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.2.1",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "rss-parser": "^3.13.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
